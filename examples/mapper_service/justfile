# Tasks for the example stage mapper service. Requires uv.

# List recipes.
default:
    @just --list

# Serve the stage mapper on :8091. Ctrl+C to stop.
run:
    uv run uvicorn app:app --host 127.0.0.1 --port 8091

# Format the code with ruff.
fmt:
    uv run ruff format .

# Lint with ruff (use `just lint --fix` to apply fixes).
lint *args:
    uv run ruff check {{ args }} .

# Type-check with ty.
typecheck:
    uv run ty check .

# Read-only checks, the way CI would run them.
check:
    uv run ruff format --check .
    uv run ruff check .
    uv run ty check .
