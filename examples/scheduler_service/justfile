# Tasks for the example scheduling service. Requires uv.

# List recipes.
default:
    @just --list

# Serve the scheduling service on :8090. Ctrl+C to stop.
run:
    uv run uvicorn app:app --host 127.0.0.1 --port 8090

# Format the code with ruff.
fmt:
    uv run ruff format .

# Lint with ruff (use `just lint --fix` to apply fixes).
lint *args:
    uv run ruff check {{ args }} .

# Type-check with ty.
typecheck:
    uv run ty check .

# Read-only checks, the way CI would run them.
check:
    uv run ruff format --check .
    uv run ruff check .
    uv run ty check .
